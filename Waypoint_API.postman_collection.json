{
  "info": {
    "_postman_id": "a3b90f42-491c-4e89-8d74-waypoint-api-v1",
    "name": "Waypoint Delivery & Logistics API",
    "description": "Production API Collection for Waypoint Delivery & Logistics Platform hosted at https://waypointapi.vercel.app.\n\n### Authentication\nMost endpoints require a JWT Bearer token. Authenticating via `/api/v1/auth/login` or `/api/v1/auth/register` will automatically set the `accessToken` variable.\n\n### Roles Supported\n- **CUSTOMER**: Creates shipments, tracks their shipments, pays via Stripe, views customer analytics.\n- **COURIER**: Views assigned shipments, updates shipment delivery status, views courier analytics.\n- **ADMIN**: Manages hubs, assigns couriers to shipments, reads all shipments/users, views full business analytics & export reports.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
